{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "marketplace: run",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/run.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "spring-boot",
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Starting MarketplaceApplication.*$",
          "endsPattern": "^.*Started MarketplaceApplication.*$"
        }
      }
    }
  ]
}
